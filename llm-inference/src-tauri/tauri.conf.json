{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saient",
  "version": "1.0.17",
  "identifier": "uk.co.saient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "fullscreen": false,
      "resizable": true,
      "decorations": false,
      "title": "Saient",
      "width": 1100,
      "height": 800,
      "minWidth": 860,
      "minHeight": 600
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:1421 ws://127.0.0.1:1421; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/engine/tinyq4-cpu": "resources/engine/tinyq4-cpu",
      "resources/engine/tinyq4-cuda": "resources/engine/tinyq4-cuda",
      "resources/engine/libcudart.so.12": "resources/engine/libcudart.so.12",
      "resources/saient/": "resources/saient/",
      "../../scripts/clean_lora_dataset.py": "resources/scripts/clean_lora_dataset.py",
      "../../scripts/enhance_video.py": "resources/scripts/enhance_video.py",
      "../../scripts/generate_cogvideo.py": "resources/scripts/generate_cogvideo.py",
      "../../scripts/generate_sdxl.py": "resources/scripts/generate_sdxl.py",
      "../../scripts/generate_video.py": "resources/scripts/generate_video.py",
      "../../scripts/generate_wan_i2v.py": "resources/scripts/generate_wan_i2v.py",
      "../../scripts/merge_checkpoints.py": "resources/scripts/merge_checkpoints.py",
      "../../scripts/saient_paths.py": "resources/scripts/saient_paths.py",
      "../../scripts/train_lora_sdxl.py": "resources/scripts/train_lora_sdxl.py",
      "../../scripts/tts_kokoro.py": "resources/scripts/tts_kokoro.py",
      "../../scripts/vision.py": "resources/scripts/vision.py"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "conflicts": ["ai-workshop"],
        "replaces": ["ai-workshop"]
      },
      "appimage": { "bundleMediaFramework": true }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
